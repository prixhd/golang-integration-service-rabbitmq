{
    "swagger": "2.0",
    "info": {
        "description": "Swagger api for golang service",
        "title": "Golang integration service rabbitmq swagger",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/result/{id}": {
            "get": {
                "description": "Returns result of a task",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Retrieves result based on given ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Result ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.GetResultResponse"
                        }
                    },
                    "400": {
                        "description": "Task ID is required",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "This task not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "This method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/status/{id}": {
            "get": {
                "description": "Returns the current processing status of a task",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Retrieves status based on given ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Status ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.GetTaskResponse"
                        }
                    },
                    "400": {
                        "description": "Task ID is required",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "This task not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "This method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/task": {
            "post": {
                "description": "Accepts code for asynchronous processing",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Create a new task",
                "parameters": [
                    {
                        "description": "Task data",
                        "name": "task",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.CreateTaskRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.CreateTaskResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_handlers.CreateTaskRequest": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "language": {
                    "type": "string"
                }
            }
        },
        "internal_handlers.CreateTaskResponse": {
            "type": "object",
            "properties": {
                "task_id": {
                    "type": "string"
                }
            }
        },
        "internal_handlers.GetResultResponse": {
            "type": "object",
            "properties": {
                "result": {
                    "type": "string"
                }
            }
        },
        "internal_handlers.GetTaskResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                }
            }
        }
    }
}